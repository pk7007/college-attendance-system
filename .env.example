# Settings for `docker compose`. Copy this file to `.env` (same folder) and edit it.
# .env is ignored by Git, so your passwords stay on your computer.

# Database passwords. Change them before the first start; MySQL keeps the first values it sees.
CAM_DB_PASSWORD=change-this-db-password
CAM_DB_ROOT_PASSWORD=change-this-root-password

# First administrator account, created on first start if it does not exist (password: 12+ characters).
# With SPRING_PROFILES_ACTIVE=prod the admin must choose a new password at first sign-in.
CAM_BOOTSTRAP_ADMIN_EMAIL=admin@college.test
CAM_BOOTSTRAP_ADMIN_PASSWORD=CampusAdmin-Change-123!

# dev = also creates a demo faculty, demo student and sample class. Use prod for a real college.
SPRING_PROFILES_ACTIVE=dev

# Web address: http://localhost:8080. Set CAM_BIND=0.0.0.0 to let other computers on your network connect.
CAM_PORT=8080
CAM_BIND=127.0.0.1

# Timezone used for "today" (for example Asia/Kolkata, Europe/London, America/New_York).
TZ=UTC
