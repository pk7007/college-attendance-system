# Settings for ./start-local.sh (macOS / Linux without Docker).
# Copy to local-config.env and edit. local-config.env is ignored by Git.
# Keep values in single quotes so characters such as $ or ! in passwords are used exactly as typed.
CAM_DB_HOST='127.0.0.1'
CAM_DB_PORT='3306'
CAM_DB_NAME='college_attendance'
CAM_DB_USER='attendance'
CAM_DB_PASSWORD='REPLACE_WITH_YOUR_DATABASE_PASSWORD'
CAM_BOOTSTRAP_ADMIN_EMAIL='admin@college.test'
CAM_BOOTSTRAP_ADMIN_PASSWORD='CampusAdmin-Change-123!'
CAM_DEMO_FACULTY_PASSWORD='FacultyDemo-2026!'
CAM_DEMO_STUDENT_PASSWORD='StudentDemo-2026!'
# dev also creates a demo faculty, student and class; use prod for a real college.
SPRING_PROFILES_ACTIVE='dev'
